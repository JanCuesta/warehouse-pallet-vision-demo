# Local environments and generated Python files
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ROS 2 workspace build outputs
sim/ros2_ws/build/
sim/ros2_ws/install/
sim/ros2_ws/log/

